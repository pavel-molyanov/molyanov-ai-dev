# User-spec planning interview
# Questions and answers are preserved verbatim. Topic fields track what is known and still open.

interview_metadata:
  started: ""
  last_updated: ""
  status: "in_progress"  # in_progress | completed
  can_resume: true

conversation_history: []
# Entry format:
# - asked_at: "YYYY-MM-DD HH:MM:SS"
#   topic_keys: ["user_problem", "success_criteria"]
#   agent_questions: |
#     Full question batch, verbatim.
#   user_answer: |
#     Full user answer, verbatim.

